FROM amazon/aws-lambda-python:3.9

# Install torch (CPU-only) via extra-index-url (so that NVIDIA dependencies are not pulled in)
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu torch

# 安装 ultralytics 及主要依赖（不覆盖 torch），并补充 pillow、matplotlib、requests
RUN pip install --no-cache-dir --no-deps ultralytics supervision opencv-python-headless numpy boto3 pillow matplotlib requests

# Copy from the current build context (i.e. the directory where you run docker build) into /var/task
COPY ./lambda_video.py /var/task/
COPY ./birds_detection.py /var/task/

# Set the CMD to your Lambda handler
CMD [ "lambda_video.lambda_handler" ] 